   "ts_iso": "2026-01-23T23:27:15+00:00",
   "from_me": false,
   "sender_jid": null,
   "type": 0,
   "text": "Y las gyonzas? Esas son normalmente con gluten no?",
   "starred": false
  },
  {
   "id": 1664514,
   "key_id": "ACE4CE90AC7B7C45DDA9A1567AC2FA36",
