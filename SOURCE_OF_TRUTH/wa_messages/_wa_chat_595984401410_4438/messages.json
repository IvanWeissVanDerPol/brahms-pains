   "key_id": "3EB0E25EF79CC21536E24C",
   "ts_ms": 1766605447000,
   "ts_iso": "2025-12-24T19:44:07+00:00",
   "from_me": true,
   "sender_jid": null,
   "type": 0,
   "text": "conoces por si acaso gente trabajando en labs kinda related to this?\n\npara contactar y mostrar lo que preparamos?",
